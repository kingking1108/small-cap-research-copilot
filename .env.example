# Chat and embeddings each point at an OpenAI-compatible API. This works
# with OVHcloud AI Endpoints (values below), OpenAI, Azure OpenAI, Groq,
# Together, Mistral, OpenRouter, a local Ollama/vLLM/llama.cpp server, or
# any other provider speaking the same protocol - just swap the base
# URL/model/key for the provider you're using.
#
# OVHcloud example: copy the exact base URL from the "Documentation" tab of
# the model you picked in the catalog:
# https://www.ovhcloud.com/en/public-cloud/ai-endpoints/catalog/
LLM_API_KEY=
LLM_CHAT_BASE_URL=https://<your-chat-model-endpoint>/api/openai_compat/v1
LLM_CHAT_MODEL=gpt-oss-120b
LLM_EMBEDDINGS_BASE_URL=https://<your-embeddings-endpoint>/api/openai_compat/v1
LLM_EMBEDDINGS_MODEL=Qwen3-Embedding-8B

# Optional: agent tracing via Langfuse (https://cloud.langfuse.com, free tier
# available, or self-hosted). Leave both blank to run without tracing.
# Get keys from your Langfuse project settings after signing up.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
