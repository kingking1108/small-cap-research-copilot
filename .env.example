# OVHcloud AI Endpoints — each model has its own base URL. Copy the exact
# values from the "Documentation" tab of the model you picked in the catalog:
# https://www.ovhcloud.com/en/public-cloud/ai-endpoints/catalog/
OVH_API_KEY=
OVH_CHAT_BASE_URL=https://<your-chat-model-endpoint>/api/openai_compat/v1
OVH_CHAT_MODEL=gpt-oss-120b
OVH_EMBEDDINGS_BASE_URL=https://<your-embeddings-endpoint>/api/openai_compat/v1
OVH_EMBEDDINGS_MODEL=Qwen3-Embedding-8B
